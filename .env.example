# Copy to .env.local and fill in. Never commit real values. Everything here has a free tier.
# No keys at all? `npm run dev` still starts; the assistant simply answers that no model is configured.

# Primary LLM: NVIDIA NIM (https://build.nvidia.com). Optional if you set GEMINI_API_KEY.
NVIDIA_API_KEY=
# Optional model override (default lives in src/lib/assistant/config.ts)
NVIDIA_MODEL=

# Fallback LLM and the embedding model: Google AI Studio (https://aistudio.google.com/apikey).
# Needed for `npm run kb:index` (dense embeddings). Without it the index is BM25-only.
GEMINI_API_KEY=

# Optional: shared rate-limit store (Upstash Redis free tier). Without it an in-memory limiter is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Salt used to hash visitor IPs for rate limiting and the anonymised log. Any long random string.
IP_HASH_SALT=

# Optional: force provider order/subset, e.g. "gemini" or "nvidia,gemini"
ASSISTANT_PROVIDERS=
